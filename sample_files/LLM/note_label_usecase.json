{
  "code": "hf_llm_label",
  "path": "/LLM/Diagnosis/HeartFailure_LLM",
  "type": "assertion",
  "description": "LLM-derived heart failure label from clinical notes",
  "blob": {
    "target_patient_set":   ["mimic_iv_icu_subset_1k"],
    "note_concept_paths":   ["/MIMIC/notes/discharge", "/MIMIC/notes/radiology"],
    "prompt_template":      "cohort_labeling",
    "prompt_variables": {
      "condition":  "heart failure",
      "definition": "presence of any of: NYHA class symptoms, BNP > 400 pg/mL, or echo EF < 40%"
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "label":      {"type": "integer", "enum": [0, 1]},
        "confidence": {"type": "number",  "minimum": 0, "maximum": 1},
        "evidence":   {"type": "string"}
      },
      "required": ["label", "confidence"]
    },
    "provider": {
      "name":  "local_hf",
      "model": "meta-llama/Meta-Llama-3-8B-Instruct",
      "external_provider": false
    },
    "guardrails": {
      "min_confidence":             0.7,
      "require_evidence_substring": true,
      "case_sensitive_evidence":    false,
      "max_retries":                2
    },
    "sampling": {
      "temperature": 0.0,
      "max_tokens":  512,
      "random_seed": 42
    },
    "data_period_start": "2008-01-01",
    "data_period_end":   "2019-12-31",
    "audit_level":       "full",
    "_comment_cache_prompt": "set provider.cache_prompt=true for cohorts > 1000 patients with stable prompt templates (Anthropic only)"
  }
}
