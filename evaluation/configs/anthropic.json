{
  "_comment": "Anthropic Claude Sonnet 4.5 config. REQUIRES ANTHROPIC_API_KEY env var. external_provider MUST be exactly true (boolean) — strings like 'true' / 'false' are rejected by the H-1 strict gate.",
  "prompt_template": "cohort_labeling",
  "prompt_variables": {
    "condition": "heart failure",
    "definition": "presence of any of: NYHA class symptoms, BNP > 400 pg/mL, or echo EF < 40%"
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "label": {"type": "integer", "enum": [0, 1]},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "evidence": {"type": "string"}
    },
    "required": ["label", "confidence"]
  },
  "provider": {
    "name": "anthropic",
    "model": "claude-sonnet-4-5",
    "external_provider": true,
    "cache_prompt": false
  },
  "guardrails": {
    "min_confidence": 0.5,
    "require_evidence_substring": true,
    "case_sensitive_evidence": false,
    "max_retries": 2
  },
  "sampling": {
    "temperature": 0.0,
    "max_tokens": 512
  },
  "audit_level": "full"
}
