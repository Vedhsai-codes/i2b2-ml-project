{
  "_comment": "LocalHF Llama-3-8B-Instruct config. NO API key needed but requires GPU (or 20+ min/patient on Mac CPU). Model downloads on first use (~16 GB). For Discovery GPU runs.",
  "prompt_template": "cohort_labeling",
  "prompt_variables": {
    "condition": "heart failure",
    "definition": "presence of any of: NYHA class symptoms, BNP > 400 pg/mL, or echo EF < 40%"
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "label": {"type": "integer", "enum": [0, 1]},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "evidence": {"type": "string"}
    },
    "required": ["label", "confidence"]
  },
  "provider": {
    "name": "local_hf",
    "model": "meta-llama/Meta-Llama-3-8B-Instruct"
  },
  "guardrails": {
    "min_confidence": 0.5,
    "require_evidence_substring": true,
    "case_sensitive_evidence": false,
    "max_retries": 2
  },
  "sampling": {
    "temperature": 0.0,
    "max_tokens": 512
  },
  "audit_level": "full"
}
