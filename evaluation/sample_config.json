{
  "_comment": "Sample eval config matching LLM_MODULE_SPEC §2.5 note_label_usecase blob shape. Drop in real provider creds and adjust prompt for your task.",
  "prompt_template": "cohort_labeling",
  "prompt_variables": {
    "condition": "heart failure",
    "definition": "presence of any of: NYHA class symptoms, BNP > 400 pg/mL, or echo EF < 40%"
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "label": {"type": "integer", "enum": [0, 1]},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "evidence": {"type": "string"}
    },
    "required": ["label", "confidence"]
  },
  "provider": {
    "name": "mock",
    "model": "mock-deterministic"
  },
  "guardrails": {
    "min_confidence": 0.5,
    "require_evidence_substring": true,
    "case_sensitive_evidence": false,
    "max_retries": 2
  },
  "sampling": {
    "temperature": 0.0,
    "max_tokens": 512,
    "random_seed": 42
  },
  "audit_level": "full"
}
